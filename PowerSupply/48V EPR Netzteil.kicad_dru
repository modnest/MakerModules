(version 1)
(rule "Track width, outer layer (1oz copper)"
	(layer outer)
	(condition "A.Type == 'track'")
	(constraint track_width (min 0.1mm))
)
(rule Track_spacing__outer_layer__1oz_copper_
	(layer outer)
	(constraint clearance (min 0.1mm))
	(condition "A.Type == 'track' && B.Type == A.Type")
)
(rule "Track width, inner layer"
	(layer inner)
	(condition "A.Type == 'track'")
	(constraint track_width (min 0.09mm))
)
(rule Track_spacing__inner_layer
	(layer inner)
	(constraint clearance (min 0.09mm))
	(condition "A.Type == 'track' && B.Type == A.Type")
)
(rule "Silkscreen text"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1mm))
)
(rule "Pad to Silkscreen"
	(layer outer)
	(condition "A.Type == 'pad' && B.Layer == '?.Silkscreen'")
	(constraint silk_clearance (min 0.15mm))
)
(rule "Edge (routed) to track clearance"
	(condition "A.Type == 'track'")
	(constraint edge_clearance (min 0.3mm))
)
(rule Annular_ring_width__PTH_
	(layer outer)
	(constraint annular_width (min 0.25mm))
	(condition "A.isPlated()")
)
(rule Clearance__Pad_hole_to_hole
	(layer outer)
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.IsPlated() && B.IsPlated()")
)
(rule Clearance__Via_hole_to_hole
	(layer outer)
	(constraint hole_to_hole (min 0.2mm))
	(condition "A.Type == 'via' && B.Type == A.Type")
)
(rule Clearance__track_to_NPTH_hole__perimeter_
	# (condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track' && A.Net != B.Net")
	(layer outer)
	(constraint hole_clearance (min 0.2mm))
	(condition "!A.isPlated() && B.Type == 'track' && A.Net != B.Net")
)
(rule Clearance__track_to_PTH_hole_perimeter
	(layer outer)
	(constraint hole_clearance (min 0.35mm))
	(condition "A.isPlated() && B.Type == 'track' && A.Net != B.Net")
)
(rule Clearance__track_to_pad
	(layer outer)
	(constraint clearance (min 0.1mm))
	(condition "A.Type == 'pad' && B.Type == 'track' && A.Net != B.Net")
)
(rule Clearance__SMD_Pad_to_SMD_Pad
	# (condition "(A.Type == 'Pad' || A.Type == 'Via') && (B.Type == 'Pad' || B.Type == 'Via') && A.Net != B.Net")	
	(layer outer)
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'pad' && B.Type == A.Type && A.Pad_Type == 'SMD' && B.Pad_Type == A.Pad_Type && B.Net != A.Net")
)
(rule Track_spacing__same_Net
	(constraint clearance (min 0.25mm))
	(condition "A.Type == 'track' && B.Type == A.Type && B.Net == A.Net")
)
(rule Courtyard_clearance_1
	(constraint courtyard_clearance (min 0.1mm))
)
(rule Clearence__track_to_Via
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'via' && B.Type == 'track' || B.Type == 'zone' && B.Net != A.Net")
)
(rule Annular_ring_width__Via_
	(layer outer)
	(constraint annular_width (min 0.075mm))
	(condition "A.Type == 'via'")
)
(rule Annular_ring_width__PTH__1
	(layer outer)
	(constraint annular_width (min 0.45mm))
	(condition "!A.isPlated()")
)
(rule Minimum_drill_size_Via_und_PTH
	(layer outer)
	(constraint hole_size (min 0.15mm))
	(condition "A.IsPlated()")
)
(rule Minimum_drill_size_NPTH
	(layer outer)
	(constraint hole_size (min 0.5mm))
	(condition "!A.IsPlated()")
)
(rule Minimum_soldermask_sliver
	(constraint solder_mask_sliver (min 0.1mm))
)
(rule Clearance__track_to_PTH_Pad
	(layer inner)
	(constraint clearance (min 0.3mm))
	(condition "A.Type == 'pad' && B.Type == 'track' && A.Net != B.Net && A.IsPlated()")
)
